{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./index.html)",
      "Edit(./tests/**)",
      "Edit(./CLAUDE.md)",
      "Bash(python3 tests/run-all.py:*)",
      "Bash(python3 tests/e2e/*)",
      "Bash(node --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./.gitignore)",
      "Edit(./server-setup/**)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(bash server-setup/*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git add .)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(printenv:*)",
      "Bash(env)"
    ]
  }
}
